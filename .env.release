# Neutraler Kunden-/Release-Build (tools/build-release.ps1, vite --mode release):
# Instanz-Werte der lokalen .env gezielt LEEREN. Leere Werte sind Absicht -
# PowerShell kann keine leeren Prozess-Env-Vars setzen (loescht sie stattdessen),
# daher der Weg ueber diese Mode-Datei. Keine Secrets hier eintragen!
VITE_VAPID_PUBLIC_KEY=
VITE_DEFAULT_LANGUAGE=
VITE_FOOTER_CREDIT=
