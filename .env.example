# Festivadget – Build-Time-Credentials (NIE echte Werte committen, §6.6).
# Kopiere diese Datei nach .env und trage echte Werte ein.

# Joomla Web-Services REST API (read-only Token, gescoped)
JOOMLA_API_TOKEN=dein-joomla-api-token

# WordPress REST API (Application Password, Basic-Auth)
WP_USER=dein-wp-benutzer
WP_APP_PW=xxxx xxxx xxxx xxxx xxxx xxxx

# Web-Push (Phase 5): öffentlicher VAPID-Key (kommt in den Client-Build).
# Erzeugen mit: php push/vapid-keys.php  → den PUBLIC-Key hier eintragen.
# Der PRIVATE-Key gehört NUR in push/config.php auf dem Server (nie committen).
VITE_VAPID_PUBLIC_KEY=

