# Festivadget – Build-Time-Credentials (NIE echte Werte committen, §6.6).
# Kopiere diese Datei nach .env und trage echte Werte ein.

# Joomla Web-Services REST API (read-only Token, gescoped)
JOOMLA_API_TOKEN=dein-joomla-api-token

# WordPress REST API (Application Password, Basic-Auth)
WP_USER=dein-wp-benutzer
WP_APP_PW=xxxx xxxx xxxx xxxx xxxx xxxx

# Web-Push (Phase 5): öffentlicher VAPID-Key – OPTIONALER Fallback.
# Die App holt den Key zur Laufzeit von /push/vapid.php (aus push/config.php);
# hier gesetzt ist der Push-Schalter schon beim allerersten Aufruf sichtbar.
# Der PRIVATE-Key gehört NUR in push/config.php auf dem Server (nie committen).
VITE_VAPID_PUBLIC_KEY=


# Standard-App-Sprache der Instanz: de/en/fr/es (leer = en, z. B. im Kunden-Release).
VITE_DEFAULT_LANGUAGE=

# Fusszeilen-Text unter "Mehr" (leer = "Festivadget by vibesbuilder").
VITE_FOOTER_CREDIT=
